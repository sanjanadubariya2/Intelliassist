# Ignore rules for the AI service image.
#
# The build context is this folder, so nothing here needs to exclude the
# backend, frontend or widget the way the old root-level file did.

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Tests and evaluation datasets are not part of the runtime image.
tests/
evaluation/

# Secrets never enter an image.
.env
.env.*
!.env.example

*.md
!README.md
