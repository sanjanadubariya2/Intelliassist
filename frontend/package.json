{
  "name": "intelliassist-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "predev": "node scripts/reset-stale-build.mjs dev",
    "prebuild": "node scripts/reset-stale-build.mjs build"
  },
  "dependencies": {
    "lucide-react": "0.544.0",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.13": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
