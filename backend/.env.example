# IntelliAssist backend configuration.
#
# Copy to .env and fill in. Nothing here is a real secret: every value marked
# REQUIRED must be replaced before this runs anywhere but a laptop.
#
# .env is gitignored. Only this file is tracked.

# ----------------------------------------------------------------- server ---
SERVER_PORT=8080
# local | dev | prod. `prod` disables API docs, hides health detail and stops
# the server advertising its version.
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# --------------------------------------------------------------- database ---
# The backend's own database, separate from the AI service's. They may share a
# Postgres server; they never share a schema.
DB_URL=jdbc:postgresql://localhost:5432/intelliassist_backend
DB_USERNAME=intelliassist
DB_PASSWORD=intelliassist
DB_POOL_SIZE=10

# -------------------------------------------------------------------- jwt ---
# REQUIRED. No default: the application refuses to start without it rather than
# issuing tokens signed with a predictable key.
#
#   openssl rand -base64 48
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30
JWT_EXPIRATION=12h

# ------------------------------------------------------------- ai service ---
# The Python RAG service. Private: it must not be reachable from the internet,
# and no browser ever addresses it directly.
AI_SERVICE_BASE_URL=http://localhost:8000

# REQUIRED. Shared secret sent as X-API-Key. Server-side only - never returned
# by an API, never logged, never stored in the database, never sent to a
# browser. Must match INTELLIASSIST_APP__API_KEY in the AI service.
AI_SERVICE_API_KEY=

AI_SERVICE_CONNECT_TIMEOUT=2s
AI_SERVICE_READ_TIMEOUT=10s
# Generation is slow; the AI service's own model timeout is 60s.
AI_SERVICE_QUERY_TIMEOUT=70s
# Streaming bounds latency, not length: how long to wait for the stream to
# start, then how long a silence is tolerated once it is flowing.
AI_SERVICE_STREAM_FIRST_EVENT_TIMEOUT=75s
AI_SERVICE_STREAM_IDLE_TIMEOUT=30s

# ------------------------------------------------------------------- cors ---
# Dashboard origins, comma-separated. Never "*": the dashboard sends
# credentials, and a wildcard with credentials is both rejected by browsers and
# unsafe in principle.
#
# Widget endpoints under /api/v1/public are configured separately in code and
# accept any origin without credentials, because they are constrained by each
# bot's registered domains instead.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------------------- single sign-on ---
# Optional. A provider is offered only when both its id and secret are set.
# OAUTH_PUBLIC_URL is this backend as the browser reaches it; each provider
# must have <OAUTH_PUBLIC_URL>/api/v1/auth/oauth/<provider>/callback
# registered as an allowed redirect URI. OAUTH_FRONTEND_URL is the dashboard,
# where the browser lands afterwards.
OAUTH_FRONTEND_URL=http://localhost:3000
OAUTH_PUBLIC_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ------------------------------------------------------------ file upload ---
# Matches the AI service's own ceiling; a larger value here helps nobody.
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=52MB

# -------------------------------------------------------------------- docs ---
# Swagger UI and the OpenAPI document. Left on for development; the prod
# profile disables them regardless of this value.
API_DOCS_ENABLED=true
