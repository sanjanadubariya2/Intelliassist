# IntelliAssist configuration.
#
# Every value below is read exactly once, at startup, by app/core/config.py.
# No other module reads the environment and no model name is hardcoded anywhere
# else in the tree. Nested settings use a double underscore: SECTION__FIELD.
#
# Copy to .env and fill in the API key.

# ----------------------------------------------------------------- app ------
INTELLIASSIST_APP__ENV=local
INTELLIASSIST_APP__DEBUG=true
INTELLIASSIST_APP__LOG_LEVEL=INFO
# Human-readable console logs locally; set true for JSON in deployed envs.
INTELLIASSIST_APP__LOG_JSON=false

# Shared secret for the X-API-Key header sent by the Spring Boot service.
# Optional when ENV=local; REQUIRED when ENV=staging or production.
INTELLIASSIST_APP__API_KEY=dev-local-key-change-me

# ------------------------------------------------------------ providers -----
# Accepted under any of: INTELLIASSIST_GEMINI_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY
GEMINI_API_KEY=

# ------------------------------------------------------------- database -----
INTELLIASSIST_DATABASE__URL=postgresql+asyncpg://intelliassist:intelliassist@localhost:5432/intelliassist
INTELLIASSIST_DATABASE__POOL_SIZE=10
INTELLIASSIST_DATABASE__ECHO=false

# ---------------------------------------------------------------- redis -----
INTELLIASSIST_REDIS__URL=redis://localhost:6379/0

# ------------------------------------------------------------ embedding -----
INTELLIASSIST_EMBEDDING__PROVIDER=gemini
INTELLIASSIST_EMBEDDING__MODEL=gemini-embedding-001
# Must stay <= 2000: pgvector cannot build an HNSW index above that.
INTELLIASSIST_EMBEDDING__DIMENSION=768
INTELLIASSIST_EMBEDDING__BATCH_SIZE=32

# ------------------------------------------------------------------ llm -----
INTELLIASSIST_LLM__PROVIDER=gemini
INTELLIASSIST_LLM__MODEL=gemini-3.8-flash
INTELLIASSIST_LLM__TEMPERATURE=0.2
INTELLIASSIST_LLM__MAX_OUTPUT_TOKENS=1536

# ------------------------------------------------------------- chunking -----
INTELLIASSIST_CHUNKING__TARGET_TOKENS=500
INTELLIASSIST_CHUNKING__OVERLAP_TOKENS=80

# ------------------------------------------------------------ retrieval -----
INTELLIASSIST_RETRIEVAL__DENSE_TOP_K=50
INTELLIASSIST_RETRIEVAL__BM25_TOP_K=50
INTELLIASSIST_RETRIEVAL__RRF_K=60
INTELLIASSIST_RETRIEVAL__RERANK_CANDIDATES=30
INTELLIASSIST_RETRIEVAL__FINAL_TOP_N=6
# Below this reranker score the service abstains without calling the LLM.
INTELLIASSIST_RETRIEVAL__MIN_RERANK_SCORE=-2.0

# ------------------------------------------------------------- reranker -----
# Set false to run without torch installed (uses the passthrough reranker).
INTELLIASSIST_RERANKER__ENABLED=true
INTELLIASSIST_RERANKER__MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
INTELLIASSIST_RERANKER__DEVICE=auto
